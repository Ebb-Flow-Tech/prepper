# Prepper frontend environment.
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* values are inlined into the browser
# bundle at build time — never put a secret behind that prefix.

# ---- Backend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase: Prepper's own project (app-native sessions) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Supabase: Passport's project (hosted-login sessions) ----
# The second browser client, selected by the `prepper_auth_provider` cookie.
# ANON/PUBLIC key only — never the service-role key, which would ship to every browser.
# Leave both blank to run with SSO off: sessions stay app-native and the Passport
# client is never constructed.
NEXT_PUBLIC_PASSPORT_SUPABASE_URL=
NEXT_PUBLIC_PASSPORT_SUPABASE_ANON_KEY=

# ---- AI (server-side route handlers only) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Messaging (server-side route handlers only) ----
SENDGRID_API_KEY=
SENDER_EMAIL=
SENDER_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_FROM_NUMBER=

# ---- Lark (server-side route handlers only) ----
LARK_APP_ID=
LARK_APP_SECRET=
