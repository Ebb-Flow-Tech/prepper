# Application Settings
APP_NAME="Recipe Builder API"
DEBUG=false

# Database (PostgreSQL via Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# API
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Supabase — Prepper's OWN project (auth + recipe-image storage)
#
# SUPABASE_KEY must be the SERVICE_ROLE key, not the anon key, despite the name.
# Dashboard -> Project Settings -> API Keys -> `service_role` (marked secret).
# Two consumers require service_role and fail with the anon key:
#   - supabase_auth_service.auth.admin.create_user  (an admin API the anon key cannot call)
#   - storage_service                               (writes to the bucket as Bearer + apikey)
# This said "your-supabase-anon-key" and was wrong: registration and image upload failed with a
# key that looked correct and authenticated fine everywhere else.
#
# It bypasses RLS. Backend only — never ship it to the client, never commit a real one here.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=prepper
SUPABASE_RECIPE_IMAGES_FOLDER=recipe-images
SUPABASE_TASTING_NOTE_IMAGES_FOLDER=tasting-note-images
SUPABASE_INGREDIENT_TASTING_NOTE_IMAGES_FOLDER=ingredient-tasting-note-images

# Antropic API Key (for agents)
ANTHROPIC_API_KEY=your-antropic-api-key

# Passport sync consumer (identity / org / entitlement platform).
# Leave unset to run without Passport: the sync endpoint stays unmounted and
# identity reporting is a no-op. Never commit real values.
PASSPORT_API_URL=https://passport.example.com
PASSPORT_API_KEY=your-passport-app-api-key
PASSPORT_WEBHOOK_SECRET=your-passport-webhook-secret
# Set only during a 24h webhook-secret rotation overlap; clear afterwards.
PASSPORT_WEBHOOK_SECRET_PREV=

TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=changeme


# SSO kill switch. DEFAULTS TO TRUE, and the default is the trap: this backend already has
# PASSPORT_SUPABASE_URL set in every deployed environment (it shipped with the dual-issuer verify
# seam), and `sso_active` is exactly `SSO_ENABLED and PASSPORT_SUPABASE_URL`. So the FIRST boot of a
# release carrying the email-first router has SSO fully ON unless this is explicitly set to false —
# the router sends every member to Passport's hosted login and /auth/login starts 403-ing them.
#
# The documented rollout ("deploy dark, then flip it on") therefore requires setting this to false
# BEFORE the backend deploy, as a real secret in each environment. There is no [env] block in
# fly.toml, so nothing else will do it for you.
#
# Set false to hard-disable during an incident: everyone routes app-native, no endpoint refuses a
# member, and the app works as it did before. Safe only because the app-native branch still exists —
# but see the plan's rollback note: it does NOT cover members provisioned by the Passport callback,
# who have no credential on Prepper's own project.
SSO_ENABLED=false

# Passport's Supabase project — the shared issuer whose tokens this backend accepts and verifies.
# There is no PASSPORT_SUPABASE_ANON_KEY here on purpose: the backend never signs into Passport's
# GoTrue under Model 3 (the browser does the hosted login; the code exchange uses PASSPORT_API_KEY).
# The anon key belongs to the frontend, as NEXT_PUBLIC_PASSPORT_SUPABASE_ANON_KEY.
PASSPORT_SUPABASE_URL=https://your-passport-project.supabase.co

# Passport hosted login (Model 3, OAuth 2.1 + PKCE).
# PASSPORT_DASHBOARD_URL is the host the BROWSER is sent to for /authorize — a different host from
# PASSPORT_API_URL, which the backend calls server-to-server for the code exchange.
# SSO_CALLBACK_URL must match the URI registered on Passport's per-app sign-in-callback allow-list
# byte for byte (Apps -> Prepper -> Sign-in callbacks), NOT the Supabase project-level redirect list.
# FRONTEND_URL receives the session fragment on success and every failure redirect.
PASSPORT_DASHBOARD_URL=https://passport.example.com
SSO_CALLBACK_URL=https://your-api-host/api/v1/auth/passport/callback
FRONTEND_URL=http://localhost:3000