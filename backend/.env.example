# Application Settings
APP_NAME="Recipe Builder API"
DEBUG=false

# Database (PostgreSQL via Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# API
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Supabase — Prepper's OWN project (auth + recipe-image storage)
#
# SUPABASE_KEY must be the SERVICE_ROLE key, not the anon key, despite the name.
# Dashboard -> Project Settings -> API Keys -> `service_role` (marked secret).
# Two consumers require service_role and fail with the anon key:
#   - supabase_auth_service.auth.admin.create_user  (an admin API the anon key cannot call)
#   - storage_service                               (writes to the bucket as Bearer + apikey)
# This said "your-supabase-anon-key" and was wrong: registration and image upload failed with a
# key that looked correct and authenticated fine everywhere else.
#
# It bypasses RLS. Backend only — never ship it to the client, never commit a real one here.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=prepper
SUPABASE_RECIPE_IMAGES_FOLDER=recipe-images
SUPABASE_TASTING_NOTE_IMAGES_FOLDER=tasting-note-images
SUPABASE_INGREDIENT_TASTING_NOTE_IMAGES_FOLDER=ingredient-tasting-note-images

# Antropic API Key (for agents)
ANTHROPIC_API_KEY=your-antropic-api-key

# Passport sync consumer (identity / org / entitlement platform).
# Leave unset to run without Passport: the sync endpoint stays unmounted and
# identity reporting is a no-op. Never commit real values.
PASSPORT_API_URL=https://passport.example.com
PASSPORT_ORG_ID=00000000-0000-0000-0000-000000000000
PASSPORT_API_KEY=your-passport-app-api-key
PASSPORT_WEBHOOK_SECRET=your-passport-webhook-secret
# Set only during a 24h webhook-secret rotation overlap; clear afterwards.
PASSPORT_WEBHOOK_SECRET_PREV=

TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=changeme


PASSPORT_SUPABASE_URL=https://your-passport-project.supabase.co
PASSPORT_SUPABASE_ANON_KEY=your-passport-anon-key